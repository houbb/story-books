{
  "name": "storybook-engine",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "A Digital Storybook / Interactive Story Atlas — Markdown as source, Story Tree as structure, Book as reader.",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.2",
    "@vue-flow/core": "^1.41.6",
    "@vue-flow/minimap": "^1.5.2",
    "gray-matter": "^4.0.3",
    "markdown-it": "^14.1.0",
    "page-flip": "^2.0.7",
    "pinia": "^2.2.6",
    "vue": "^3.5.13",
    "vue-router": "^4.4.5",
    "@vueuse/core": "^11.2.0",
    "@playwright/test": "^1.51.0",
    "vitest": "^2.1.8"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.10.1",
    "@vitejs/plugin-vue": "^5.2.1",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vue-tsc": "^2.1.10"
  },
  "engines": {
    "node": ">=20"
  }
}
